# The external data root. The large trees under it are supplied by the
# replicator (a clone of the marcap archive, the FnGuide export) and are never
# committed; the small registry tables under data/registry/ are, because a
# clone has to carry them.
/data/*
!/data/registry/

# Generated daily panels — large; replicators rebuild via `make data`.
results/kr_universe_panel.parquet
results/full_daily_data_*.parquet
results/hml_factor_daily.csv
results/_cache/

# Note: the analysis result JSON/CSV under results/ and the generated tables
# and macros under tables/ are tracked as the canonical snapshot the submitted
# manuscript was built from, so the manuscript source the code-availability URL
# publishes compiles from a fresh clone. Each generator writes its published
# output at the path the document reads, so a re-run overwrites the committed
# artifact in place; review with `git diff` before committing.


# Audit instruments (issue lists, integrity reports, coverage tables). These
# record what is not yet established and must never reach a reader of the
# repository. They are untracked, not deleted. The directory is what is
# ignored, because a pattern naming one report is a list that is true when
# written and silently false the day the next instrument is added.
_internal/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# LaTeX artifacts (regenerated by `make pdf`)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*-eps-converted-to.pdf

# Compiled manuscript PDFs (regenerated by `make pdf`)
/qf_paper.pdf

# Build output of the online supplement, a LaTeX build product that is never
# tracked. The supplement's source was folded into the article's appendices,
# so no target writes this file any more.
/qf_paper_supplement.pdf

# Virtual environments
.venv/
venv/

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Local Claude Code session state
.claude/
